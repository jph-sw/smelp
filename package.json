{
	"name": "smerp",
	"private": true,
	"license": "AGPL-3.0-only",
	"scripts": {
		"clean": "rm -rf node_modules bun.lockb",
		"dev": "bun run dev:api & bun run dev:web",
		"dev:api": "bun --watch ./apps/api/src/index.ts",
		"dev:web": "bun run --cwd apps/web dev",
		"build:web": "bun run --cwd apps/web build",
		"migrate:new": "bun run scripts/migrate-new.ts",
		"admin:reset-link": "bun run apps/api/scripts/create-reset-link.ts",
		"test": "bun test",
		"chore:format": "bunx --bun @biomejs/biome format --write",
		"chore:check": "bunx --bun @biomejs/biome check --write"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.5.7"
	}
}
