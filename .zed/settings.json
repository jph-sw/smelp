{
	"languages": {
		"TypeScript": {
			"language_servers": ["!eslint", "vtsls", "biome"],
			"formatter": { "language_server": { "name": "biome" } }
		},
		"TSX": {
			"language_servers": ["!eslint", "vtsls", "biome"],
			"formatter": { "language_server": { "name": "biome" } }
		},
		"JSON": {
			"language_servers": ["biome"],
			"formatter": { "language_server": { "name": "biome" } }
		},
		"JSONC": {
			"language_servers": ["biome"],
			"formatter": { "language_server": { "name": "biome" } }
		}
	}
}
