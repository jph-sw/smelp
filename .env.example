# Copy to .env. Everything here is optional, and smelp runs without any of it.

# The version to run, from CHANGELOG.md. Without it, docker compose pull gets the newest.
# SMELP_VERSION=0.11.0

# The port on this machine.
# SMELP_PORT=3000

# Browsers refuse the login cookie over plain HTTP, except on localhost, so signing
# in fails. Set this to try smelp on a local network, and remove it once you have HTTPS.
# SECURE_COOKIES=false

# Set this when running behind a reverse proxy that sets X-Forwarded-For, so rate
# limits see each person's address. Without a proxy, leave it off.
# TRUST_PROXY=true

# Attached files. They're stored in an attachments folder beside the database, which
# is on the data volume in Docker. The limit is per file, in megabytes.
# MAX_ATTACHMENT_MB=25
# ATTACHMENTS_PATH=

# Email. It turns on when SMTP_HOST, SMTP_FROM and APP_URL are all set.
# SMTP_HOST=smtp.example.com
# SMTP_FROM=smelp <smelp@example.com>
# APP_URL=https://smelp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Sign in with OpenID Connect (Google, GitLab, Authentik, Keycloak...). It turns on
# when the first four are set, and APP_URL above is shared with email. Register
# APP_URL/api/auth/oidc/callback as the redirect URI with the provider.
# OIDC_ISSUER_URL=https://auth.example.com/realms/main
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_BUTTON_LABEL=Sign in with Authentik
